{
  "manifest_version": 3,
  "name": "YouTube Gemini Vorleser",
  "version": "1.1.0",
  "description": "Fasst YouTube-Videos mit der Gemini-Funktion („Ask“) zusammen und liest die Zusammenfassung per Google Text-to-Speech vor.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Zusammenfassung vorlesen (Gemini + Google TTS)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/lib/text.js",
        "src/lib/settings.js",
        "src/lib/messages.js",
        "src/lib/youtube-dom.js",
        "src/lib/page-button.js",
        "src/lib/runner.js",
        "src/lib/overlay.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "offscreen",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://texttospeech.googleapis.com/*"
  ],
  "commands": {
    "_execute_action": {
      "description": "Zusammenfassung vorlesen / stoppen"
    }
  }
}
